  "decisions": [
    {
      "id": "decision_scope_v1",
      "date": "2026-04-19",
      "meeting": "产品评审会",
      "content": "首版只上线结构化摘要、行动项抽取和风险提示，不上线自动周报推送。",
      "source": "data/minutes/product_review_minutes.md"
    },
    {
      "id": "decision_architecture_v1",
      "date": "2026-04-21",
      "meeting": "技术评审会",
      "content": "抽取服务采用异步队列，会议结束后写入结构化结果表，前端只读取已确认字段。",
      "source": "data/minutes/tech_review_minutes.md"
    },
    {
      "id": "decision_gray_v1",
      "date": "2026-04-26",
      "meeting": "上线前 Go/No-Go 会议",
      "content": "本周五进入 20% 灰度，失败率超过 3% 或 P95 延迟超过 12 秒时回滚。",
      "source": "data/minutes/go_no_go_minutes.md"
    },
    {
      "id": "decision_preview_only",
      "date": "2026-04-18",
      "meeting": "需求澄清与范围对齐会",
      "content": "行动项同步只生成预览建议，负责人确认前不创建正式任务。",
      "source": "data/minutes/requirement_alignment_minutes.md"
    },
    {
      "id": "decision_no_weekly_report",
      "date": "2026-04-19",
      "meeting": "产品评审会",
      "content": "自动生成团队周报不进入本次 MVP，避免跨会议聚合和权限扩散。",
      "source": "data/minutes/product_review_minutes.md"
    },
    {
      "id": "decision_reconcile_readonly",
      "date": "2026-04-22",
      "meeting": "架构深评会",
      "content": "Reconciler 只输出冲突建议，不直接覆盖 priority board 或任务系统。",
      "source": "data/minutes/architecture_review_minutes.md"
    },
    {
      "id": "decision_p95_gate_9s",
      "date": "2026-04-22",
      "meeting": "架构深评会",
      "content": "60 分钟会议 P95 gate 收紧到 9 秒，作为扩大灰度前置条件。",
      "source": "data/minutes/architecture_review_minutes.md"
    },
    {
      "id": "decision_security_blocker",
      "date": "2026-04-23",
      "meeting": "安全评审会",
      "content": "权限越权告警是 P0 阻断项，出现一次即停止放量。",
      "source": "data/minutes/security_review_minutes.md"
    },
    {
      "id": "decision_eval_split_metrics",
      "date": "2026-04-24",
      "meeting": "评测口径校准会",
      "content": "行动项 precision、recall、字段完整率和 source coverage 分开统计。",
      "source": "data/minutes/evaluation_calibration_minutes.md"
    },
    {
      "id": "decision_customer_copy_p0",
      "date": "2026-04-25",
      "meeting": "客户反馈复盘会",
      "content": "“待确认创建”文案进入 P0 修复，避免用户误解任务已创建。",
      "source": "data/minutes/customer_feedback_review_minutes.md"
    },
    {
      "id": "decision_hold_50_percent",
      "date": "2026-05-06",
      "meeting": "灰度上线复盘会",
      "content": "20% 灰度继续运行，暂不在 2026-05-06 扩大到 50%。",
      "source": "data/minutes/launch_retro_minutes.md"
    }
  ],
