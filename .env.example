# MeetingFlow Agent local configuration example.
# Copy to .env for local testing. Never commit real values.

MEETINGFLOW_PROVIDER=mock
MEETINGFLOW_DRY_RUN=true
LARK_CLI_BIN=lark-cli

FEISHU_APP_ID=<your_feishu_app_id>
FEISHU_APP_SECRET=<your_feishu_app_secret>
FEISHU_TENANT_KEY=<your_test_tenant_key>
FEISHU_USER_ACCESS_TOKEN=<your_user_access_token_if_needed>
FEISHU_BOT_CHAT_ID=<your_test_bot_chat_id>
FEISHU_BASE_APP_TOKEN=<your_test_base_app_token>
FEISHU_BASE_TABLE_ID=<your_test_base_table_id>
FEISHU_DOC_TEST_TOKEN=<your_test_doc_token_or_url>
FEISHU_MINUTES_TEST_TOKEN=<your_test_minutes_token>
FEISHU_CALENDAR_ID=<your_test_calendar_id>
